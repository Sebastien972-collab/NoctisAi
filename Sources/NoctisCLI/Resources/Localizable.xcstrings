    "Command failed. Check Swift, Xcode, Git or GitHub CLI authentication." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command failed. Check Swift, Xcode, Git or GitHub CLI authentication."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la commande. Vérifie Swift, Xcode, Git ou l’authentification de GitHub CLI."
          }
        }
      }
    },
    "console.cli.interactive_help" : {
      "comment" : "Message affiché par le CLI.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/help          Help\n/clear         Clear conversation context and input history\n/model         Show the active model\n/workspace     Show the authorized folder\n/workspace /absolute/path   Change folder after confirmation\n/workspace off             Revoke local access and restore Web search\n/permissions   Show permissions and limits\n/exit          Quit (exit and Ctrl+D also work)\n\nEnd a line with \\ to continue on the next line.\n↑/↓ arrows: session history · Ctrl+U: clear input\nCtrl+C: discard input or interrupt the response.\nWriting and system commands remain disabled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/help          Aide\n/clear         Effacer le contexte et l’historique de saisie\n/model         Afficher le modèle actif\n/workspace     Afficher le dossier autorisé\n/workspace /chemin/absolu   Changer de dossier après confirmation\n/workspace off            Retirer l’accès local et retrouver la recherche Web\n/permissions   Afficher les autorisations et limites\n/exit          Quitter (exit et Ctrl+D fonctionnent aussi)\n\nTermine une ligne par \\ pour continuer sur la suivante.\nFlèches ↑/↓ : historique de session · Ctrl+U : effacer la ligne\nCtrl+C : abandonner la saisie ou interrompre la réponse.\nLes écritures et commandes système restent désactivées."
          }
        }
      }
    },
    "console.cli.usage" : {
      "comment" : "Message affiché par le CLI.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage: noctis [--workspace /absolute/path]\n  noctis --help       Show this help\n  noctis --version    Show the installed version\n  noctis doctor       Check the installation without loading the model\n  noctis update       Install the latest verified stable version\n  noctis update --check      Check without installing\n  noctis update --dev        Build main after confirmation\n  noctis update --rollback   Restore the previous version\n\nThe current folder is available read-only, without automatic analysis.\nThe model loads only when you ask your first question."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation : noctis [--workspace /chemin/absolu]\n  noctis --help       Afficher cette aide\n  noctis --version    Afficher la version installée\n  noctis doctor       Vérifier l’installation sans charger le modèle\n  noctis update       Installer la dernière version stable vérifiée\n  noctis update --check      Vérifier sans installer\n  noctis update --dev        Compiler main après confirmation\n  noctis update --rollback   Restaurer la version précédente\n\nLe dossier courant est disponible en lecture seule, sans analyse automatique.\nLe modèle est chargé à la première question uniquement."
          }
        }
      }
    },
    "console.doctor.summary" : {
      "comment" : "Message affiché par le CLI.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostics without loading or downloading the model.\nOptional Web search: local SearXNG runtime or server at 127.0.0.1:8888.\nBuilding requires Xcode, Swift 6.4 and the Metal component."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostic sans chargement ni téléchargement du modèle.\nRecherche Web optionnelle : runtime SearXNG local ou serveur sur 127.0.0.1:8888.\nPour les commandes de compilation : Xcode, Swift 6.4 et le composant Metal sont requis."
          }
        }
      }
    },
    "console.error.details" : {
