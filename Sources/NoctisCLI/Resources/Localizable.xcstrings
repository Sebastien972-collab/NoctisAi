{
  "sourceLanguage" : "fr",
  "strings" : {
    "An update is available." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An update is available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mise à jour est disponible."
          }
        }
      }
    },
    "Automatic restoration failed. The previous version is preserved under versions; restore the current link manually." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic restoration failed. The previous version is preserved under versions; restore the current link manually."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration automatique a échoué. L’ancienne version reste dans versions ; restaure le lien current manuellement."
          }
        }
      }
    },
    "Cannot activate this version. Check installation permissions; no privilege elevation is attempted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot activate this version. Check installation permissions; no privilege elevation is attempted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’activer cette version. Vérifie les permissions d’installation ; aucune élévation de privilèges n’est tentée."
          }
        }
      }
    },
    "Cannot create a private temporary file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
