        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développement uniquement : main n’est pas une version stable. La compilation peut exécuter des plugins de packages Swift."
          }
        }
      }
    },
    "Development updates require an interactive terminal and explicit confirmation." : {
