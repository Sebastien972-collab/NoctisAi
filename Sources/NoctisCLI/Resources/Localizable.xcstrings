    "console.workspace.usage" : {
      "comment" : "Message affiché par le CLI.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage: NoctisCLI [--workspace /absolute/project/path]\nWith --workspace, you authorize reading this directory. Then ask your questions normally. During conversation: /workspace /absolute/path to authorize a directory; /workspace off to revoke access. No code mode to enable. Type exit to quit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation : NoctisCLI [--workspace /chemin/absolu/du/projet]\nAvec --workspace, vous autorisez la lecture de ce dossier. Posez ensuite vos questions normalement. Pendant la conversation : /workspace /chemin/absolu pour autoriser un dossier ; /workspace off pour révoquer. Aucun mode code à activer. Tapez exit pour quitter."
          }
        }
      }
    },
    "Development only: main is not a stable release. Building may execute Swift package plugins." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development only: main is not a stable release. Building may execute Swift package plugins."
