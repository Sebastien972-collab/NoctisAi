    "console.permissions.summary" : {
      "comment" : "Message affiché par le CLI.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read access is limited to the authorized folder, only when your request needs it.\nSensitive files, symbolic links and files over 64 KiB are denied.\nWriting and system commands are disabled in this version.\nNo local access when /workspace off is active."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture limitée au dossier autorisé, uniquement pour répondre à tes demandes.\nFichiers sensibles, liens symboliques et fichiers de plus de 64 Kio : refusés.\nÉcriture et commandes système : désactivées dans cette version.\nAucun accès local lorsque /workspace off est actif."
          }
        }
      }
    },
