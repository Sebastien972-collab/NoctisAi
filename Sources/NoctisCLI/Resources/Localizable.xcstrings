    "console.workspace.invalid" : {
      "comment" : "Message affiché par le CLI.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directory refused or invalid arguments. Provide an existing directory with an absolute path without symbolic links."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier refusé ou arguments invalides. Indiquez un dossier existant avec un chemin absolu sans lien symbolique."
          }
        }
      }
    },
    "console.workspace.iteration_limit" : {
      "comment" : "Message affiché par le CLI.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysis limit reached. No final conclusion was produced; try a more specific request."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite d’analyse atteinte. Aucune conclusion finale n’a été produite ; reformulez une demande plus précise."
          }
        }
      }
    },
